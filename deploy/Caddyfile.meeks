# Site block for Meeks, to append to the Caddyfile of the fronting Caddy.
#
# Meeks records the visitor's IP and source port for disclosure requests, so
# the real client address must reach it:
#   - via Cloudflare's proxy: take CF-Connecting-IP, but only when the
#     connection really comes from Cloudflare (otherwise the header could be
#     forged by connecting to the origin directly). The source port is not
#     available in this case.
#   - direct (DNS only): pass the TCP peer address and port.
# Cloudflare ranges: https://www.cloudflare.com/ips/ (keep in sync).

meeks.paps.jp {
	encode gzip

	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

	handle @cloudflare {
		reverse_proxy meeks:8080 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			header_up -X-Real-Port
		}
	}
	handle {
		reverse_proxy meeks:8080 {
			header_up X-Real-IP {http.request.remote.host}
			header_up X-Real-Port {http.request.remote.port}
		}
	}

	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
