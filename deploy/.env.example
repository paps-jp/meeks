SITE_URL=https://meeks.paps.jp
# Global IPv4 of this server (advertised for TURN relays and used as TURN host)
PUBLIC_IP=
# openssl rand -hex 32
TURN_SECRET=
# Where Meeks serves HTTP. Use the gateway IP of the fronting Caddy's Docker
# network so only Caddy can reach it:
#   docker network inspect passist_pn --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
HTTP_ADDR=172.18.0.1:8080
IPLOG_DAYS=730
# UDP ports for TURN relays (open them in every firewall in front of the server)
TURN_RELAY_MIN=30000
TURN_RELAY_MAX=30999
# Simultaneous TURN relays: in total, and per connected user. Browsers
# reserve relays (UDP and TCP) for every peer while a room is open.
TURN_MAX_ALLOCS=1000
TURN_MAX_ALLOCS_PER_USER=30

# Optional backup relay: Cloudflare Realtime TURN (listed after the embedded
# TURN, so browsers prefer ours). Create a TURN key in the Cloudflare
# dashboard (Realtime > TURN).
CF_TURN_KEY_ID=
CF_TURN_KEY_TOKEN=
# Required to enforce the monthly cap; without them the backup stays off.
# Account ID, and an API token with "Account Analytics: Read".
CF_ACCOUNT_ID=
CF_ANALYTICS_TOKEN=
# Stop offering Cloudflare TURN (and revoke its credential) at this much
# account-wide TURN egress per calendar month (the free tier is 1000 GB,
# shared with the Realtime SFU).
CF_TURN_MONTHLY_GB=900
